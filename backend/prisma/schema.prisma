generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
}

enum ResourceType {
  CASE
  LAW_SUMMARY
  VIDEO
  ARTICLE
}

enum QuestionType {
  SINGLE
  TRUE_FALSE
  SCENARIO
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AssignmentTargetType {
  LEVEL
  RESOURCE
}

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
}

enum RiskStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  nickname     String
  grade        String?
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())

  teachingClasses Class[]       @relation("TeacherClasses")
  classMemberships ClassMember[]
  attempts         Attempt[]
  progress         UserProgress[]
  resources        Resource[]
  submissions      AssignmentSubmission[]
  comicReads       ComicRead[]
  profiles         StudentProfile[]
  chatMessages     AiChatMessage[]
  goals            StudentGoal[]
  riskEvents       RiskEvent[]
  gameResults      GameResult[]
  questionAnswers  QuestionAnswer[]
  skillAxes        SkillAxis[]
}

model Class {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())

  teacher     User          @relation("TeacherClasses", fields: [teacherId], references: [id])
  members     ClassMember[]
  assignments Assignment[]

  @@index([teacherId])
}

model ClassMember {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  student User  @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([studentId])
}

model LearningUnit {
  id         String  @id @default(cuid())
  title      String
  category   String
  gradeRange String
  orderNo    Int
  isActive   Boolean @default(true)

  levels Level[]

  @@index([orderNo])
}

model Level {
  id        String  @id @default(cuid())
  unitId    String
  title     String
  orderNo   Int
  xpReward  Int     @default(10)
  isActive  Boolean @default(true)

  unit      LearningUnit   @relation(fields: [unitId], references: [id])
  questions Question[]
  attempts  Attempt[]
  progress  UserProgress[]

  @@index([unitId, orderNo])
}

model Question {
  id          String       @id @default(cuid())
  levelId     String
  type        QuestionType
  prompt      String       @db.Text
  optionsJson String?      @db.Text
  answerKey   String
  explanation String?      @db.Text
  orderNo     Int
  difficulty  Int          @default(0) // 0=auto, 1=easy, 2=medium, 3=hard (for adaptive difficulty)

  level Level @relation(fields: [levelId], references: [id])
  answers QuestionAnswer[]

  @@index([levelId, orderNo])
}

model Attempt {
  id           String   @id @default(cuid())
  studentId    String
  levelId      String
  score        Int
  correctCount Int
  totalCount   Int
  createdAt    DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id])
  level   Level @relation(fields: [levelId], references: [id])

  @@index([studentId, createdAt])
  @@index([levelId])
}

// 逐题作答记录。
//
// 原先 Attempt 只存每关的总分与做对题数，没有任何逐题信息，导致「智能错题复盘」
// 里的题型正确率只能靠把错题数按题目数量平均分摊来估算 —— 实际效果是：
// 某关 5 题错 1~2 题则所有题型都算 100%，错 3 题以上则所有题型都算 0%，
// 阈值卡在 50%，与题型毫无关系。
//
// 名称刻意不叫 AnswerRecord：项目历史上有过一张同名表（已随迁移清除），
// 重名会让后来者困惑。
model QuestionAnswer {
  id         String   @id @default(cuid())
  studentId  String
  levelId    String
  questionId String
  answer     String // 学生所选
  correct    Boolean
  createdAt  DateTime @default(now())

  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([studentId, questionId])
  @@index([studentId, createdAt])
}

model UserProgress {
  id        String         @id @default(cuid())
  studentId String
  levelId   String
  status    ProgressStatus @default(NOT_STARTED)
  bestScore Int            @default(0)
  updatedAt DateTime       @updatedAt

  student User  @relation(fields: [studentId], references: [id])
  level   Level @relation(fields: [levelId], references: [id])

  @@unique([studentId, levelId])
  @@index([levelId])
}

model Resource {
  id        String       @id @default(cuid())
  title     String
  type      ResourceType
  tagsJson  String       @db.Text
  contentUrl String?     @db.Text
  contentMd String?      @db.Text
  createdBy String
  createdAt DateTime     @default(now())

  author User @relation(fields: [createdBy], references: [id])

  @@index([type])
  @@index([createdBy])
}

model Assignment {
  id         String              @id @default(cuid())
  classId    String
  targetType AssignmentTargetType
  targetId   String
  dueAt      DateTime?
  createdAt  DateTime            @default(now())

  class       Class                 @relation(fields: [classId], references: [id])
  submissions AssignmentSubmission[]

  @@index([classId, createdAt])
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
}

model ComicRead {
  id        String   @id @default(cuid())
  studentId String
  storyId   String
  // 读完后的总结题作答。未作答时为 null —— 读完整篇的 +10 XP 不受影响，
  // 答对才另发 +5，低门槛入门的定位不能动。
  quizOptionId String?
  quizCorrect  Boolean?
  createdAt DateTime @default(now())

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, storyId])
  @@index([studentId])
}

model StudentProfile {
  id             String   @id @default(cuid())
  studentId      String   @unique
  topicMasteries Json     // [{"topic":"校园安全","mastery":85,"questionsTotal":12,"questionsCorrect":10,"trend":"up"}]
  weakAreas      Json     // [{"topic":"网络安全","questionType":"SCENARIO","failCount":3,"suggestion":"建议重看漫画"}]
  strengths      Json     // [{"topic":"校园安全","accuracy":92,"questionType":"TRUE_FALSE"}]
  learningStyle  Json     // {"preferredTypes":["SINGLE"],"activePattern":"afternoon","pace":"steady","weeklyAvgAttempts":3.5}
  lastAnalyzed   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AiChatMessage {
  id        String   @id @default(cuid())
  studentId String
  role      String   // 'user' | 'assistant'
  content   String   @db.Text
  sessionId String
  createdAt DateTime @default(now())

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, sessionId])
  @@index([studentId, createdAt])
}

model StudentGoal {
  id          String   @id @default(cuid())
  studentId   String
  weekStart   DateTime
  title       String
  description String?
  targetType  String   // 'COMPLETE_LEVELS' | 'REVIEW_LEVELS' | 'DAILY_ACTIVE' | 'STUDY_HOURS'
  targetCount Int
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, weekStart, targetType])
  @@index([studentId, weekStart])
}

// 学生与 AI 对话中识别出的风险事件。同一学生同一类型在 24h 内聚合成一条，
// triggerCount 累加而不是生成新记录，避免刷屏把教师端淹掉。
model RiskEvent {
  id           String     @id @default(cuid())
  studentId    String
  // 触发时学生所属班级。用来把事件归到某位班主任名下，也保证学生退班后历史仍可查
  classId      String?
  kind         String     // '自伤风险' | '遭受侵害' | '校园欺凌' | '网络风险' | '情绪困扰' 等
  level        RiskLevel
  snippet      String     @db.Text // 触发的原句（仅此一句，不存整段对话）
  summary      String?    @db.Text // 模型生成的风险描述
  suggestion   String?    @db.Text // 模型生成的疏导建议
  triggerCount Int        @default(1)
  lastSeenAt   DateTime
  status       RiskStatus @default(OPEN)
  handledBy    String? // 处置教师的 userId，仅作留痕
  handledNote  String?    @db.Text
  handledAt    DateTime?
  createdAt    DateTime   @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, kind, status])
  @@index([status, lastSeenAt])
}

// 模拟法庭 / 案件侦查的单局最好成绩。成绩由前端计算后上报，服务端无法复算，
// 这张表的作用是记录「这个学生在这个案件上已经拿到过多少分」，
// 以便像关卡一样按最好成绩结算 XP —— 否则反复提交同一个案件就能反复拿 XP。
model GameResult {
  id        String   @id @default(cuid())
  studentId String
  gameType  String // 'COURT' | 'DETECTIVE'
  caseId    String
  bestPct   Int      @default(0) // 0-100
  // 具体错在哪：漏了哪条线索、哪个证人的秘密没问出、哪道题选错。
  // 只用于诊断，绝不参与 XP 结算 —— XP 仍只由 bestPct 驱动。
  // 形状与大小由 zod 在入口校验（见 routes/student.ts 的 DetailSchema）。
  detail    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, gameType, caseId])
  @@index([studentId, gameType])
}

// 学生的能力轴累计计数器。存计数而不是百分比，因为诊断必须能区分
// 「样本不足」和「掌握度低」—— 只玩过侦查的学生在 ARGUE 轴上一条样本
// 都没有，报「表达论辩 0 分」既错误又打击人。百分比随时可算，样本量算不回来。
model SkillAxis {
  id        String   @id @default(cuid())
  studentId String
  axis      String // 'OBSERVE' | 'INTERVIEW' | 'EVIDENCE' | 'REASONING' | 'LAW' | 'ARGUE'
  correct   Int      @default(0)
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, axis])
  @@index([studentId])
}
